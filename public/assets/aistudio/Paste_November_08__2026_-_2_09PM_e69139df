<!-- Vanilla Micro-Interactions, Wheel Picker & Celebration Engine -->
<script>
  (function() {
    let currentStep = 1;
    let cycleLength = 28;
    let flowDuration = 5;
    let selectedContraception = 'natural';

    // Acoustic haptic drop synthesizer
    const playHapticDrop = (freq = 440, type = 'sine') => {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(freq * 1.8, audioCtx.currentTime + 0.05);
        gain.gain.setValueAtTime(0.06, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.07);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.07);
      } catch (e) {}
    };

    // DOM references
    const step1 = document.getElementById('step1');
    const step2 = document.getElementById('step2');
    const step3 = document.getElementById('step3');
    const backBtn = document.getElementById('backBtn');
    const nextBtn = document.getElementById('nextBtn');
    const nextBtnText = document.getElementById('nextBtnText');
    const nextBtnIcon = document.getElementById('nextBtnIcon');
    const currentStepText = document.getElementById('currentStepText');
    const seg1 = document.getElementById('segment1');
    const seg2 = document.getElementById('segment2');
    const seg3 = document.getElementById('segment3');

    // Steppers & dynamic preview
    const previewDayCount = document.getElementById('previewDayCount');
    const cycleMinus = document.getElementById('cycleMinus');
    const cyclePlus = document.getElementById('cyclePlus');
    const flowMinus = document.getElementById('flowMinus');
    const flowPlus = document.getElementById('flowPlus');
    const flowDurationDisplay = document.getElementById('flowDurationDisplay');
    const flowStatusBadge = document.getElementById('flowStatusBadge');
    const flowStatusDot = document.getElementById('flowStatusDot');
    const cycleProgressCircle = document.getElementById('cycleProgressCircle');
    const ringOvulationDay = document.getElementById('ringOvulationDay');
    const cycleStatusTip = document.getElementById('cycleStatusTip');
    const wheelPicker = document.getElementById('wheelPicker');
    const flowWheelPicker = document.getElementById('flowWheelPicker');

    // Transition & Home screen references
    const transitionScreen = document.getElementById('transitionScreen');
    const transitionBar = document.getElementById('transitionBar');
    const homeScreenView = document.getElementById('homeScreenView');
    const onboardingScreenView = document.getElementById('onboardingScreenView');
    const replayOnboardingBtn = document.getElementById('replayOnboardingBtn');
    const toastDismissBtn = document.getElementById('toastDismissBtn');
    const welcomeToast = document.getElementById('welcomeToast');
    const particleCanvas = document.getElementById('particleCanvas');
    const skipBtn = document.getElementById('skipBtn');

    // Build Interactive 3D Cylindrical Wheel Picker (Numbers 21 to 42 for Cycle)
    const minDay = 21;
    const maxDay = 42;
    const wheelItems = [];

    const buildWheelPicker = () => {
      wheelPicker.innerHTML = '';
      for (let day = minDay; day <= maxDay; day++) {
        const item = document.createElement('div');
        item.className = 'wheel-item flex items-center justify-center w-full py-2.5 transition-all duration-150 cursor-pointer text-center font-bold tracking-tight';
        item.dataset.day = day;
        item.innerHTML = `<span class="wheel-num transition-all duration-200 text-2xl text-secondary/50 font-semibold">${day}</span>`;
        
        item.addEventListener('click', () => {
          playHapticDrop(520);
          updateCycle(day, true);
        });

        wheelPicker.appendChild(item);
        wheelItems.push({ el: item, day: day });
      }
      highlightWheelItem(cycleLength, false);
    };

    const highlightWheelItem = (selectedDay, smoothScroll = true) => {
      wheelItems.forEach(item => {
        const numSpan = item.el.querySelector('.wheel-num');
        const diff = Math.abs(item.day - selectedDay);
        
        if (item.day === selectedDay) {
          item.el.classList.add('active-wheel-day');
          numSpan.className = 'wheel-num transition-all duration-200 text-4xl text-primary font-black scale-110 drop-shadow-sm';
          if (smoothScroll) {
            item.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            item.el.scrollIntoView({ behavior: 'auto', block: 'center' });
          }
        } else if (diff === 1) {
          numSpan.className = 'wheel-num transition-all duration-200 text-2xl text-on-surface/80 font-bold opacity-75';
        } else if (diff === 2) {
          numSpan.className = 'wheel-num transition-all duration-200 text-xl text-secondary/60 font-semibold opacity-50';
        } else {
          numSpan.className = 'wheel-num transition-all duration-200 text-lg text-secondary/30 font-medium opacity-25';
        }
      });
    };

    // Cycle Wheel Scroll listener with debounced snap calculation
    let isScrollingTimeout;
    wheelPicker.addEventListener('scroll', () => {
      clearTimeout(isScrollingTimeout);
      isScrollingTimeout = setTimeout(() => {
        const pickerRect = wheelPicker.getBoundingClientRect();
        const pickerCenter = pickerRect.top + pickerRect.height / 2;

        let closestDay = cycleLength;
        let smallestDistance = Infinity;

        wheelItems.forEach(item => {
          const itemRect = item.el.getBoundingClientRect();
          const itemCenter = itemRect.top + itemRect.height / 2;
          const dist = Math.abs(pickerCenter - itemCenter);
          if (dist < smallestDistance) {
            smallestDistance = dist;
            closestDay = item.day;
          }
        });

        if (closestDay !== cycleLength) {
          playHapticDrop(480);
          updateCycle(closestDay, false);
        }
      }, 70);
    });

    // Update cycle calculations
    const updateCycle = (val, scrollWheel = true) => {
      cycleLength = Math.max(minDay, Math.min(maxDay, val));
      previewDayCount.textContent = cycleLength;

      const half = Math.round(cycleLength / 2);
      ringOvulationDay.textContent = `Tahmini Ovülasyon: ${half}. Gün`;

      // Status description
      if (cycleLength >= 26 && cycleLength <= 32) {
        cycleStatusTip.textContent = `Sağlıklı & Düzenli (${cycleLength} gün)`;
        cycleStatusTip.previousElementSibling.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
      } else if (cycleLength < 26) {
        cycleStatusTip.textContent = `Kısa Döngü (${cycleLength} gün)`;
        cycleStatusTip.previousElementSibling.className = 'w-2 h-2 rounded-full bg-amber-500';
      } else {
        cycleStatusTip.textContent = `Uzun Döngü (${cycleLength} gün)`;
        cycleStatusTip.previousElementSibling.className = 'w-2 h-2 rounded-full bg-rose-400';
      }

      // Ring progress offset: 251.2 circumference for r=40
      const percent = (cycleLength - 20) / (45 - 20);
      const offset = 251.2 - (percent * 150);
      cycleProgressCircle.style.strokeDashoffset = offset;

      highlightWheelItem(cycleLength, scrollWheel);
    };

    buildWheelPicker();

    cycleMinus.addEventListener('click', () => {
      playHapticDrop(420);
      updateCycle(cycleLength - 1, true);
    });
    cyclePlus.addEventListener('click', () => {
      playHapticDrop(460);
      updateCycle(cycleLength + 1, true);
    });

    // BUILD FLOW DURATION 3D WHEEL PICKER (Days 2 to 10)
    const minFlowDay = 2;
    const maxFlowDay = 10;
    const flowWheelItems = [];

    const buildFlowWheelPicker = () => {
      flowWheelPicker.innerHTML = '';
      for (let day = minFlowDay; day <= maxFlowDay; day++) {
        const item = document.createElement('div');
        item.className = 'flow-wheel-item flex items-center justify-center w-full py-2.5 transition-all duration-150 cursor-pointer text-center font-bold tracking-tight';
        item.dataset.day = day;
        item.innerHTML = `<span class="flow-wheel-num transition-all duration-200 text-2xl text-secondary/50 font-semibold">${day}</span>`;
        
        item.addEventListener('click', () => {
          playHapticDrop(470);
          updateFlow(day, true);
        });

        flowWheelPicker.appendChild(item);
        flowWheelItems.push({ el: item, day: day });
      }
      highlightFlowWheelItem(flowDuration, false);
    };

    const highlightFlowWheelItem = (selectedDay, smoothScroll = true) => {
      flowWheelItems.forEach(item => {
        const numSpan = item.el.querySelector('.flow-wheel-num');
        const diff = Math.abs(item.day - selectedDay);
        
        if (item.day === selectedDay) {
          item.el.classList.add('active-flow-day');
          numSpan.className = 'flow-wheel-num transition-all duration-200 text-4xl text-primary font-black scale-110 drop-shadow-sm';
          if (smoothScroll) {
            item.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            item.el.scrollIntoView({ behavior: 'auto', block: 'center' });
          }
        } else if (diff === 1) {
          numSpan.className = 'flow-wheel-num transition-all duration-200 text-2xl text-on-surface/80 font-bold opacity-75';
        } else if (diff === 2) {
          numSpan.className = 'flow-wheel-num transition-all duration-200 text-xl text-secondary/60 font-semibold opacity-50';
        } else {
          numSpan.className = 'flow-wheel-num transition-all duration-200 text-lg text-secondary/30 font-medium opacity-25';
        }
      });
    };

    let isFlowScrollingTimeout;
    flowWheelPicker.addEventListener('scroll', () => {
      clearTimeout(isFlowScrollingTimeout);
      isFlowScrollingTimeout = setTimeout(() => {
        const pickerRect = flowWheelPicker.getBoundingClientRect();
        const pickerCenter = pickerRect.top + pickerRect.height / 2;

        let closestDay = flowDuration;
        let smallestDistance = Infinity;

        flowWheelItems.forEach(item => {
          const itemRect = item.el.getBoundingClientRect();
          const itemCenter = itemRect.top + itemRect.height / 2;
          const dist = Math.abs(pickerCenter - itemCenter);
          if (dist < smallestDistance) {
            smallestDistance = dist;
            closestDay = item.day;
          }
        });

        if (closestDay !== flowDuration) {
          playHapticDrop(450);
          updateFlow(closestDay, false);
        }
      }, 70);
    });

    const updateFlow = (val, scrollWheel = true) => {
      flowDuration = Math.max(minFlowDay, Math.min(maxFlowDay, val));
      flowDurationDisplay.textContent = flowDuration;

      // Status badge and intensity synchronization
      if (flowDuration >= 4 && flowDuration <= 6) {
        flowStatusBadge.textContent = `${flowDuration} Gün • İdeal Süre`;
        flowStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
      } else if (flowDuration <= 3) {
        flowStatusBadge.textContent = `${flowDuration} Gün • Kısa Kanama`;
        flowStatusDot.className = 'w-2 h-2 rounded-full bg-amber-500';
      } else {
        flowStatusBadge.textContent = `${flowDuration} Gün • Uzun Kanama`;
        flowStatusDot.className = 'w-2 h-2 rounded-full bg-rose-400';
      }

      highlightFlowWheelItem(flowDuration, scrollWheel);
    };

    buildFlowWheelPicker();

    // Flow Duration Stepper
    flowMinus.addEventListener('click', () => {
      playHapticDrop(400);
      if (flowDuration > minFlowDay) {
        updateFlow(flowDuration - 1, true);
      }
    });
    flowPlus.addEventListener('click', () => {
      playHapticDrop(440);
      if (flowDuration < maxFlowDay) {
        updateFlow(flowDuration + 1, true);
      }
    });

    // Contraception method cards single selection
    const contraCards = document.querySelectorAll('.contra-card');
    contraCards.forEach(card => {
      card.addEventListener('click', () => {
        playHapticDrop(540);
        contraCards.forEach(c => {
          c.classList.remove('active-contra', 'bg-surface-container-low', 'border-primary-container');
          c.classList.add('bg-white', 'border-surface-variant/80');
          const check = c.querySelector('.contra-check');
          check.classList.remove('bg-primary-container', 'text-white');
          check.classList.add('bg-surface-variant', 'text-transparent');
        });

        card.classList.add('active-contra', 'bg-surface-container-low', 'border-primary-container');
        card.classList.remove('bg-white', 'border-surface-variant/80');
        const check = card.querySelector('.contra-check');
        check.classList.remove('bg-surface-variant', 'text-transparent');
        check.classList.add('bg-primary-container', 'text-white');
        selectedContraception = card.dataset.contra;
      });
    });

    // Step Rendering
    const renderStep = (step) => {
      playHapticDrop(460);
      currentStep = step;
      currentStepText.textContent = step;

      if (step === 1) {
        step1.classList.remove('hidden');
        step2.classList.add('hidden');
        step3.classList.add('hidden');
        backBtn.classList.add('hidden');
        nextBtnText.textContent = 'Devam Et';
        nextBtnIcon.textContent = 'arrow_forward';

        seg1.className = 'h-2 flex-1 rounded-full bg-primary-container shadow-sm transition-all duration-500 ease-out flex items-center justify-end pr-0.5';
        seg2.className = 'h-2 flex-1 rounded-full bg-surface-variant transition-all duration-500 ease-out';
        seg3.className = 'h-2 flex-1 rounded-full bg-surface-variant transition-all duration-500 ease-out';
      } else if (step === 2) {
        step1.classList.add('hidden');
        step2.classList.remove('hidden');
        step3.classList.add('hidden');
        backBtn.classList.remove('hidden');
        nextBtnText.textContent = 'Devam Et';
        nextBtnIcon.textContent = 'arrow_forward';

        seg1.className = 'h-2 flex-1 rounded-full bg-primary-container transition-all duration-500 ease-out';
        seg2.className = 'h-2 flex-1 rounded-full bg-primary-container shadow-sm transition-all duration-500 ease-out flex items-center justify-end pr-0.5';
        seg3.className = 'h-2 flex-1 rounded-full bg-surface-variant transition-all duration-500 ease-out';
        setTimeout(() => {
          highlightWheelItem(cycleLength, true);
          highlightFlowWheelItem(flowDuration, true);
        }, 80);
      } else if (step === 3) {
        step1.classList.add('hidden');
        step2.classList.add('hidden');
        step3.classList.remove('hidden');
        backBtn.classList.remove('hidden');
        nextBtnText.textContent = '✨ Flora Alanımı Başlat';
        nextBtnIcon.textContent = 'check';

        seg1.className = 'h-2 flex-1 rounded-full bg-primary-container transition-all duration-500 ease-out';
        seg2.className = 'h-2 flex-1 rounded-full bg-primary-container transition-all duration-500 ease-out';
        seg3.className = 'h-2 flex-1 rounded-full bg-primary-container shadow-sm transition-all duration-500 ease-out flex items-center justify-end pr-0.5';
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Goal Cards Selection
    const goalCards = document.querySelectorAll('.goal-card');
    goalCards.forEach(card => {
      card.addEventListener('click', () => {
        playHapticDrop(500);
        goalCards.forEach(c => {
          c.classList.remove('active-goal', 'bg-surface-container-low', 'shadow-md', 'border-primary-fixed');
          c.classList.add('bg-surface-container-lowest', 'shadow-sm', 'border-transparent');
          const box = c.querySelector('.goal-icon-box');
          box.classList.remove('bg-primary-container', 'text-on-primary-container', 'shadow-md');
          box.classList.add('bg-surface-container', 'text-primary');
          const disc = c.querySelector('.radio-disc');
          disc.classList.remove('bg-primary-container', 'shadow-sm');
          disc.classList.add('bg-surface-variant');
          disc.querySelector('span').classList.add('opacity-0');
        });

        card.classList.add('active-goal', 'bg-surface-container-low', 'shadow-md', 'border-primary-fixed');
        card.classList.remove('bg-surface-container-lowest', 'border-transparent');
        const box = card.querySelector('.goal-icon-box');
        box.classList.add('bg-primary-container', 'text-on-primary-container', 'shadow-md');
        box.classList.remove('bg-surface-container', 'text-primary');
        const disc = card.querySelector('.radio-disc');
        disc.classList.add('bg-primary-container', 'shadow-sm');
        disc.classList.remove('bg-surface-variant');
        disc.querySelector('span').classList.remove('opacity-0');
      });
    });

    // Flow intensity chips
    const flowChips = document.querySelectorAll('.flow-chip');
    flowChips.forEach(chip => {
      chip.addEventListener('click', () => {
        playHapticDrop(480);
        flowChips.forEach(c => {
          c.className = 'flow-chip py-2 rounded-full font-label-md text-label-md text-center bg-surface-container text-secondary transition-all';
        });
        chip.className = 'flow-chip active-chip py-2 rounded-full font-label-md text-label-md text-center bg-primary-container text-on-primary font-bold shadow-sm transition-all';
      });
    });

    // Tag pills
    const tagPills = document.querySelectorAll('.tag-pill');
    tagPills.forEach(pill => {
      pill.addEventListener('click', () => {
        playHapticDrop(510);
        const isSelected = pill.classList.contains('selected-pill');
        if (isSelected) {
          pill.classList.remove('selected-pill', 'bg-primary-container', 'text-on-primary', 'shadow-sm');
          pill.classList.add('bg-surface-container', 'text-secondary');
        } else {
          pill.classList.add('selected-pill', 'bg-primary-container', 'text-on-primary', 'shadow-sm');
          pill.classList.remove('bg-surface-container', 'text-secondary');
        }
      });
    });

    // Toggles
    const setupToggle = (btnId) => {
      const toggle = document.getElementById(btnId);
      let active = true;
      toggle.addEventListener('click', () => {
        playHapticDrop(450);
        active = !active;
        if (active) {
          toggle.classList.remove('bg-surface-variant', 'justify-start');
          toggle.classList.add('bg-primary-container', 'justify-end');
        } else {
          toggle.classList.remove('bg-primary-container', 'justify-end');
          toggle.classList.add('bg-surface-variant', 'justify-start');
        }
      });
    };
    setupToggle('togglePrivacy');
    setupToggle('toggleNotif');

    // CELEBRATION ENGINE: Canvas Rose & Golden Pollen Burst
    const launchPetalPollenBurst = () => {
      particleCanvas.classList.remove('hidden');
      particleCanvas.width = window.innerWidth;
      particleCanvas.height = window.innerHeight;
      const ctx = particleCanvas.getContext('2d');
      const particles = [];
      const colors = ['#d81b60', '#ff4081', '#ffb300', '#ffd54f', '#00bfa5', '#ffffff', '#f8bbd0'];

      for (let i = 0; i < 90; i++) {
        particles.push({
          x: window.innerWidth / 2,
          y: window.innerHeight * 0.65,
          vx: (Math.random() - 0.5) * 14,
          vy: (Math.random() - 1.3) * 16,
          size: Math.random() * 8 + 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * 360,
          vRot: (Math.random() - 0.5) * 10,
          opacity: 1,
          isPetal: Math.random() > 0.4
        });
      }

      let frame = 0;
      const render = () => {
        ctx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
        let alive = false;
        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.35; // gravity
          p.rotation += p.vRot;
          p.opacity -= 0.012;

          if (p.opacity > 0) {
            alive = true;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate((p.rotation * Math.PI) / 180);
            ctx.globalAlpha = Math.max(0, p.opacity);
            ctx.fillStyle = p.color;

            if (p.isPetal) {
              // Draw organic petal
              ctx.beginPath();
              ctx.ellipse(0, 0, p.size, p.size * 0.6, 0, 0, Math.PI * 2);
              ctx.fill();
            } else {
              // Draw golden pollen dot
              ctx.beginPath();
              ctx.arc(0, 0, p.size * 0.5, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.restore();
          }
        });

        frame++;
        if (alive && frame < 150) {
          requestAnimationFrame(render);
        } else {
          particleCanvas.classList.add('hidden');
        }
      };
      render();
    };

    // Transition Flow to Home Screen
    const completeOnboardingAndOpenHome = () => {
      // 1. Trigger celebration pollen & acoustic fan-fare
      launchPetalPollenBurst();
      playHapticDrop(650, 'triangle');
      setTimeout(() => playHapticDrop(880, 'triangle'), 120);

      // 2. Show brief loading animation
      transitionScreen.classList.remove('hidden');
      setTimeout(() => {
        transitionScreen.classList.remove('opacity-0');
        transitionBar.classList.remove('-translate-x-full');
        transitionBar.classList.add('translate-x-0');
      }, 20);

      // 3. Reveal Home Screen simulation after ~1.6s
      setTimeout(() => {
        transitionScreen.classList.add('opacity-0');
        homeScreenView.classList.remove('hidden');
        setTimeout(() => {
          transitionScreen.classList.add('hidden');
          homeScreenView.classList.remove('opacity-0');
          // play welcome chime
          playHapticDrop(780);
        }, 400);
      }, 1600);
    };

    // Navigation triggers
    nextBtn.addEventListener('click', () => {
      if (currentStep < 3) {
        renderStep(currentStep + 1);
      } else {
        // Step 3 final CTA clicked -> Trigger delight transition
        completeOnboardingAndOpenHome();
      }
    });

    backBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        renderStep(currentStep - 1);
      }
    });

    skipBtn.addEventListener('click', () => {
      renderStep(3);
    });

    // Replay Onboarding Journey from Home Screen
    replayOnboardingBtn.addEventListener('click', () => {
      playHapticDrop(500);
      homeScreenView.classList.add('opacity-0');
      setTimeout(() => {
        homeScreenView.classList.add('hidden');
        renderStep(1);
      }, 400);
    });

    toastDismissBtn.addEventListener('click', () => {
      welcomeToast.classList.add('opacity-0', '-translate-y-4');
      setTimeout(() => welcomeToast.remove(), 400);
    });

    // Water glass toggle micro-interactions
    const waterGlasses = document.querySelectorAll('#waterGlasses button');
    let waterCount = 4;
    waterGlasses.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        playHapticDrop(600 + (idx * 30));
        waterCount = idx + 1;
        document.getElementById('waterCountDisplay').textContent = `${waterCount} / 8 Bardak`;
        waterGlasses.forEach((g, i) => {
          if (i <= idx) {
            g.className = 'w-9 h-10 rounded-xl bg-primary-container text-white flex items-center justify-center font-bold text-xs shadow-xs transition active:scale-90';
          } else {
            g.className = 'w-9 h-10 rounded-xl bg-pink-100 text-pink-400 flex items-center justify-center font-bold text-xs hover:bg-pink-200 transition active:scale-90';
          }
        });
      });
    });

  })();
</script></body></html>

