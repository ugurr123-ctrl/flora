<!-- Vanilla Micro-Interactions & State Controller -->
<script>
  (function() {
    let currentStep = 1;
    let cycleLength = 28;
    let flowDuration = 5;

    // Audio context for haptic-style acoustic feedback
    const playHapticDrop = () => {
      try {
        const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';
        osc.frequency.setValueAtTime(440, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(880, audioCtx.currentTime + 0.06);
        gain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.08);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.08);
      } catch (e) {
        // Audio API not permitted or available
      }
    };

    // DOM references
    const step1 = document.getElementById('step1');
    const step2 = document.getElementById('step2');
    const step3 = document.getElementById('step3');
    const backBtn = document.getElementById('backBtn');
    const nextBtn = document.getElementById('nextBtn');
    const nextBtnText = document.getElementById('nextBtnText');
    const nextBtnIcon = document.getElementById('nextBtnIcon');
    const currentStepText = document.getElementById('currentStepText');
    const seg1 = document.getElementById('segment1');
    const seg2 = document.getElementById('segment2');
    const seg3 = document.getElementById('segment3');

    // Steppers & dynamic preview
    const cycleLenDisplay = document.getElementById('cycleLengthDisplay');
    const previewDayCount = document.getElementById('previewDayCount');
    const cycleMinus = document.getElementById('cycleMinus');
    const cyclePlus = document.getElementById('cyclePlus');
    const flowMinus = document.getElementById('flowMinus');
    const flowPlus = document.getElementById('flowPlus');
    const flowDurationDisplay = document.getElementById('flowDurationDisplay');
    const cycleProgressCircle = document.getElementById('cycleProgressCircle');
    const ringOvulationDay = document.getElementById('ringOvulationDay');
    const cycleStatusTip = document.getElementById('cycleStatusTip');

    // Modals
    const successModal = document.getElementById('successModal');
    const successModalCard = document.getElementById('successModalCard');
    const finishFlowBtn = document.getElementById('finishFlowBtn');
    const skipBtn = document.getElementById('skipBtn');

    // Update Step UI
    const renderStep = (step) => {
      playHapticDrop();
      currentStep = step;
      currentStepText.textContent = step;

      // Toggle views
      if (step === 1) {
        step1.classList.remove('hidden');
        step2.classList.add('hidden');
        step3.classList.add('hidden');
        backBtn.classList.add('hidden');
        nextBtnText.textContent = 'Devam Et';
        nextBtnIcon.textContent = 'arrow_forward';

        seg1.className = 'h-2 flex-1 rounded-full bg-primary-container shadow-sm transition-all duration-500 ease-out flex items-center justify-end pr-0.5';
        seg2.className = 'h-2 flex-1 rounded-full bg-surface-variant transition-all duration-500 ease-out';
        seg3.className = 'h-2 flex-1 rounded-full bg-surface-variant transition-all duration-500 ease-out';
      } else if (step === 2) {
        step1.classList.add('hidden');
        step2.classList.remove('hidden');
        step3.classList.add('hidden');
        backBtn.classList.remove('hidden');
        nextBtnText.textContent = 'Devam Et';
        nextBtnIcon.textContent = 'arrow_forward';

        seg1.className = 'h-2 flex-1 rounded-full bg-primary-container transition-all duration-500 ease-out';
        seg2.className = 'h-2 flex-1 rounded-full bg-primary-container shadow-sm transition-all duration-500 ease-out flex items-center justify-end pr-0.5';
        seg3.className = 'h-2 flex-1 rounded-full bg-surface-variant transition-all duration-500 ease-out';
      } else if (step === 3) {
        step1.classList.add('hidden');
        step2.classList.add('hidden');
        step3.classList.remove('hidden');
        backBtn.classList.remove('hidden');
        nextBtnText.textContent = '✨ Flora Alanımı Başlat';
        nextBtnIcon.textContent = 'check';

        seg1.className = 'h-2 flex-1 rounded-full bg-primary-container transition-all duration-500 ease-out';
        seg2.className = 'h-2 flex-1 rounded-full bg-primary-container transition-all duration-500 ease-out';
        seg3.className = 'h-2 flex-1 rounded-full bg-primary-container shadow-sm transition-all duration-500 ease-out flex items-center justify-end pr-0.5';
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Step 1: Goal Select Cards
    const goalCards = document.querySelectorAll('.goal-card');
    goalCards.forEach(card => {
      card.addEventListener('click', () => {
        playHapticDrop();
        goalCards.forEach(c => {
          c.classList.remove('active-goal', 'bg-surface-container-low', 'shadow-md');
          c.classList.add('bg-surface-container-lowest', 'shadow-sm');
          const box = c.querySelector('.goal-icon-box');
          box.classList.remove('bg-primary-container', 'text-on-primary-container', 'shadow-md');
          box.classList.add('bg-surface-container', 'text-primary');
          const disc = c.querySelector('.radio-disc');
          disc.classList.remove('bg-primary-container', 'shadow-sm');
          disc.classList.add('bg-surface-variant');
          disc.querySelector('span').classList.add('opacity-0');
        });

        card.classList.add('active-goal', 'bg-surface-container-low', 'shadow-md');
        card.classList.remove('bg-surface-container-lowest');
        const box = card.querySelector('.goal-icon-box');
        box.classList.add('bg-primary-container', 'text-on-primary-container', 'shadow-md');
        box.classList.remove('bg-surface-container', 'text-primary');
        const disc = card.querySelector('.radio-disc');
        disc.classList.add('bg-primary-container', 'shadow-sm');
        disc.classList.remove('bg-surface-variant');
        disc.querySelector('span').classList.remove('opacity-0');
      });
    });

    // Step 2: Cycle Calculations & Visualizer
    const updateCycle = (val) => {
      cycleLength = Math.max(21, Math.min(42, val));
      cycleLenDisplay.textContent = cycleLength;
      previewDayCount.textContent = cycleLength;

      const half = Math.round(cycleLength / 2);
      ringOvulationDay.textContent = `Tahmini Ovülasyon: ${half}. Gün`;

      // Status tooltip
      if (cycleLength >= 26 && cycleLength <= 32) {
        cycleStatusTip.textContent = `Sağlıklı & Düzenli (${cycleLength} gün)`;
      } else if (cycleLength < 26) {
        cycleStatusTip.textContent = `Kısa Döngü (${cycleLength} gün)`;
      } else {
        cycleStatusTip.textContent = `Uzun Döngü (${cycleLength} gün)`;
      }

      // Update ring arc offset: 251.2 is circumference for r=40
      const percent = (cycleLength - 20) / (45 - 20);
      const offset = 251.2 - (percent * 150);
      cycleProgressCircle.style.strokeDashoffset = offset;
    };

    cycleMinus.addEventListener('click', () => {
      playHapticDrop();
      updateCycle(cycleLength - 1);
    });
    cyclePlus.addEventListener('click', () => {
      playHapticDrop();
      updateCycle(cycleLength + 1);
    });

    flowMinus.addEventListener('click', () => {
      playHapticDrop();
      if (flowDuration > 2) {
        flowDuration--;
        flowDurationDisplay.textContent = flowDuration;
      }
    });
    flowPlus.addEventListener('click', () => {
      playHapticDrop();
      if (flowDuration < 10) {
        flowDuration++;
        flowDurationDisplay.textContent = flowDuration;
      }
    });

    // Flow intensity buttons
    const flowChips = document.querySelectorAll('.flow-chip');
    flowChips.forEach(chip => {
      chip.addEventListener('click', () => {
        playHapticDrop();
        flowChips.forEach(c => {
          c.className = 'flow-chip py-2 rounded-full font-label-md text-label-md text-center bg-surface-container text-secondary transition-all';
        });
        chip.className = 'flow-chip active-chip py-2 rounded-full font-label-md text-label-md text-center bg-primary-container text-on-primary font-bold shadow-sm transition-all';
      });
    });

    // Step 3: Multi-select tags
    const tagPills = document.querySelectorAll('.tag-pill');
    tagPills.forEach(pill => {
      pill.addEventListener('click', () => {
        playHapticDrop();
        const isSelected = pill.classList.contains('selected-pill');
        if (isSelected) {
          pill.classList.remove('selected-pill', 'bg-primary-container', 'text-on-primary', 'shadow-sm');
          pill.classList.add('bg-surface-container', 'text-secondary');
        } else {
          pill.classList.add('selected-pill', 'bg-primary-container', 'text-on-primary', 'shadow-sm');
          pill.classList.remove('bg-surface-container', 'text-secondary');
        }
      });
    });

    // Privacy & Notification toggles
    const setupToggle = (btnId) => {
      const toggle = document.getElementById(btnId);
      let active = true;
      toggle.addEventListener('click', () => {
        playHapticDrop();
        active = !active;
        const knob = toggle.querySelector('span');
        if (active) {
          toggle.classList.remove('bg-surface-variant', 'justify-start');
          toggle.classList.add('bg-primary-container', 'justify-end');
        } else {
          toggle.classList.remove('bg-primary-container', 'justify-end');
          toggle.classList.add('bg-surface-variant', 'justify-start');
        }
      });
    };
    setupToggle('togglePrivacy');
    setupToggle('toggleNotif');

    // Navigation triggers
    nextBtn.addEventListener('click', () => {
      if (currentStep < 3) {
        renderStep(currentStep + 1);
      } else {
        // Complete flow -> Celebration modal
        playHapticDrop();
        successModal.classList.remove('hidden');
        setTimeout(() => {
          successModal.classList.remove('opacity-0');
          successModalCard.classList.remove('scale-90');
          successModalCard.classList.add('scale-100');
        }, 10);
      }
    });

    backBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        renderStep(currentStep - 1);
      }
    });

    skipBtn.addEventListener('click', () => {
      renderStep(3);
    });

    finishFlowBtn.addEventListener('click', () => {
      playHapticDrop();
      successModal.classList.add('opacity-0');
      successModalCard.classList.add('scale-90');
      setTimeout(() => {
        successModal.classList.add('hidden');
        renderStep(1);
      }, 300);
    });

  })();
</script></main></body></html>

