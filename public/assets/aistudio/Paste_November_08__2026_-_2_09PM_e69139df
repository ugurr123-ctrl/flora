<script>
    // Toast Notification helper
    function showToast(message, icon = 'check_circle') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      toast.className = 'flex items-center gap-2 px-4 py-2.5 rounded-full bg-on-surface text-surface shadow-xl text-xs font-semibold backdrop-blur-md pointer-events-auto transform transition-all duration-300 opacity-0 translate-y-[-10px] scale-95';
      toast.innerHTML = `<span class="material-symbols-outlined text-[18px] text-primary-fixed">${icon}</span><span>${message}</span>`;
      container.appendChild(toast);

      requestAnimationFrame(() => {
        toast.classList.remove('opacity-0', 'translate-y-[-10px]', 'scale-95');
        toast.classList.add('opacity-100', 'translate-y-0', 'scale-100');
      });

      setTimeout(() => {
        toast.classList.add('opacity-0', 'scale-95', 'translate-y-[-8px]');
        setTimeout(() => toast.remove(), 300);
      }, 2600);
    }

    function triggerSpringPop(el) {
      if (!el) return;
      el.classList.remove('spring-pop');
      void el.offsetWidth;
      el.classList.add('spring-pop');
      setTimeout(() => el.classList.remove('spring-pop'), 450);
    }

