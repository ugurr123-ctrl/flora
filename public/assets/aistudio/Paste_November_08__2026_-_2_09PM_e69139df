        playHapticDrop(510);
        const isSelected = pill.classList.contains('selected-pill');
        if (isSelected) {
          pill.classList.remove('selected-pill', 'bg-primary-container', 'text-on-primary', 'shadow-sm');
          pill.classList.add('bg-surface-container', 'text-secondary');
        } else {
          pill.classList.add('selected-pill', 'bg-primary-container', 'text-on-primary', 'shadow-sm');
          pill.classList.remove('bg-surface-container', 'text-secondary');
        }
      });
    });

    // Toggles
    const setupToggle = (btnId) => {
      const toggle = document.getElementById(btnId);
      let active = true;
      toggle.addEventListener('click', () => {
        playHapticDrop(450);
        active = !active;
        if (active) {
          toggle.classList.remove('bg-surface-variant', 'justify-start');
          toggle.classList.add('bg-primary-container', 'justify-end');
        } else {
          toggle.classList.remove('bg-primary-container', 'justify-end');
          toggle.classList.add('bg-surface-variant', 'justify-start');
        }
      });
    };
    setupToggle('togglePrivacy');
    setupToggle('toggleNotif');

    // CELEBRATION ENGINE: Canvas Rose & Golden Pollen Burst
    const launchPetalPollenBurst = () => {
      particleCanvas.classList.remove('hidden');
      particleCanvas.width = window.innerWidth;
      particleCanvas.height = window.innerHeight;
      const ctx = particleCanvas.getContext('2d');
      const particles = [];
      const colors = ['#d81b60', '#ff4081', '#ffb300', '#ffd54f', '#00bfa5', '#ffffff', '#f8bbd0'];

      for (let i = 0; i < 90; i++) {
        particles.push({
          x: window.innerWidth / 2,
          y: window.innerHeight * 0.65,
          vx: (Math.random() - 0.5) * 14,
          vy: (Math.random() - 1.3) * 16,
          size: Math.random() * 8 + 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * 360,
          vRot: (Math.random() - 0.5) * 10,
          opacity: 1,
          isPetal: Math.random() > 0.4
        });
      }

      let frame = 0;
      const render = () => {
        ctx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
        let alive = false;
        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.35; // gravity
          p.rotation += p.vRot;
          p.opacity -= 0.012;

          if (p.opacity > 0) {
            alive = true;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate((p.rotation * Math.PI) / 180);
            ctx.globalAlpha = Math.max(0, p.opacity);
            ctx.fillStyle = p.color;

            if (p.isPetal) {
              // Draw organic petal
              ctx.beginPath();
              ctx.ellipse(0, 0, p.size, p.size * 0.6, 0, 0, Math.PI * 2);
              ctx.fill();
            } else {
              // Draw golden pollen dot
              ctx.beginPath();
              ctx.arc(0, 0, p.size * 0.5, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.restore();
          }
        });

        frame++;
        if (alive && frame < 150) {
          requestAnimationFrame(render);
        } else {
          particleCanvas.classList.add('hidden');
        }
      };
      render();
    };

    // Transition Flow to Home Screen
    const completeOnboardingAndOpenHome = () => {
      // 1. Trigger celebration pollen & acoustic fan-fare
      launchPetalPollenBurst();
      playHapticDrop(650, 'triangle');
      setTimeout(() => playHapticDrop(880, 'triangle'), 120);

      // 2. Show brief loading animation
      transitionScreen.classList.remove('hidden');
      setTimeout(() => {
        transitionScreen.classList.remove('opacity-0');
        transitionBar.classList.remove('-translate-x-full');
        transitionBar.classList.add('translate-x-0');
      }, 20);

      // 3. Reveal Home Screen simulation after ~1.6s
      setTimeout(() => {
        transitionScreen.classList.add('opacity-0');
        homeScreenView.classList.remove('hidden');
        setTimeout(() => {
          transitionScreen.classList.add('hidden');
          homeScreenView.classList.remove('opacity-0');
          // play welcome chime
          playHapticDrop(780);
        }, 400);
      }, 1600);
    };

    // Navigation triggers
    nextBtn.addEventListener('click', () => {
      if (currentStep < 3) {
        renderStep(currentStep + 1);
      } else {
        // Step 3 final CTA clicked -> Trigger delight transition
        completeOnboardingAndOpenHome();
      }
    });

    backBtn.addEventListener('click', () => {
      if (currentStep > 1) {
        renderStep(currentStep - 1);
      }
    });

    skipBtn.addEventListener('click', () => {
      renderStep(3);
    });

    // Replay Onboarding Journey from Home Screen
    replayOnboardingBtn.addEventListener('click', () => {
      playHapticDrop(500);
      homeScreenView.classList.add('opacity-0');
      setTimeout(() => {
        homeScreenView.classList.add('hidden');
        renderStep(1);
      }, 400);
    });

    toastDismissBtn.addEventListener('click', () => {
      welcomeToast.classList.add('opacity-0', '-translate-y-4');
      setTimeout(() => welcomeToast.remove(), 400);
    });

    // Water glass toggle micro-interactions
    const waterGlasses = document.querySelectorAll('#waterGlasses button');
    let waterCount = 4;
    waterGlasses.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        playHapticDrop(600 + (idx * 30));
        waterCount = idx + 1;
        document.getElementById('waterCountDisplay').textContent = `${waterCount} / 8 Bardak`;
        waterGlasses.forEach((g, i) => {
          if (i <= idx) {
            g.className = 'w-9 h-10 rounded-xl bg-primary-container text-white flex items-center justify-center font-bold text-xs shadow-xs transition active:scale-90';
          } else {
            g.className = 'w-9 h-10 rounded-xl bg-pink-100 text-pink-400 flex items-center justify-center font-bold text-xs hover:bg-pink-200 transition active:scale-90';
          }
        });
      });
    });

  })();
