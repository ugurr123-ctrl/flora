          toggle.classList.remove('bg-surface-variant', 'justify-start');
          toggle.classList.add('bg-primary-container', 'justify-end');
        } else {
          toggle.classList.remove('bg-primary-container', 'justify-end');
          toggle.classList.add('bg-surface-variant', 'justify-start');
        }
      });
    };
    setupToggle('togglePrivacy');
    setupToggle('toggleNotif');

    // CELEBRATION ENGINE: Canvas Rose & Golden Pollen Burst
    const launchPetalPollenBurst = () => {
      particleCanvas.classList.remove('hidden');
      particleCanvas.width = window.innerWidth;
      particleCanvas.height = window.innerHeight;
      const ctx = particleCanvas.getContext('2d');
      const particles = [];
      const colors = ['#d81b60', '#ff4081', '#ffb300', '#ffd54f', '#00bfa5', '#ffffff', '#f8bbd0'];

      for (let i = 0; i < 90; i++) {
        particles.push({
          x: window.innerWidth / 2,
          y: window.innerHeight * 0.65,
          vx: (Math.random() - 0.5) * 14,
          vy: (Math.random() - 1.3) * 16,
          size: Math.random() * 8 + 4,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * 360,
          vRot: (Math.random() - 0.5) * 10,
          opacity: 1,
          isPetal: Math.random() > 0.4
        });
      }

      let frame = 0;
      const render = () => {
        ctx.clearRect(0, 0, particleCanvas.width, particleCanvas.height);
        let alive = false;
        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.35; // gravity
          p.rotation += p.vRot;
          p.opacity -= 0.012;

          if (p.opacity > 0) {
            alive = true;
            ctx.save();
            ctx.translate(p.x, p.y);
            ctx.rotate((p.rotation * Math.PI) / 180);
            ctx.globalAlpha = Math.max(0, p.opacity);
            ctx.fillStyle = p.color;

            if (p.isPetal) {
              // Draw organic petal
              ctx.beginPath();
              ctx.ellipse(0, 0, p.size, p.size * 0.6, 0, 0, Math.PI * 2);
              ctx.fill();
            } else {
              // Draw golden pollen dot
              ctx.beginPath();
              ctx.arc(0, 0, p.size * 0.5, 0, Math.PI * 2);
              ctx.fill();
            }
            ctx.restore();
          }
        });

        frame++;
        if (alive && frame < 150) {
          requestAnimationFrame(render);
        } else {
          particleCanvas.classList.add('hidden');
        }
      };
      render();
    };

    // Transition Flow to Home Screen
    const completeOnboardingAndOpenHome = () => {
      // 1. Trigger celebration pollen & acoustic fan-fare
      launchPetalPollenBurst();
      playHapticDrop(650, 'triangle');
      setTimeout(() => playHapticDrop(880, 'triangle'), 120);

      // 2. Show brief loading animation
      transitionScreen.classList.remove('hidden');
      setTimeout(() => {
        transitionScreen.classList.remove('opacity-0');
