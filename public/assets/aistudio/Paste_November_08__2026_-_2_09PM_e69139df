    const flowChips = document.querySelectorAll('.flow-chip');
    flowChips.forEach(chip => {
      chip.addEventListener('click', () => {
        playHapticDrop(480);
        flowChips.forEach(c => {
          c.className = 'flow-chip py-2 rounded-full font-label-md text-label-md text-center bg-surface-container text-secondary transition-all';
