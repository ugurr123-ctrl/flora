        card.classList.add('active-goal', 'bg-surface-container-low', 'shadow-md', 'border-primary-fixed');
        card.classList.remove('bg-surface-container-lowest', 'border-transparent');
        const box = card.querySelector('.goal-icon-box');
        box.classList.add('bg-primary-container', 'text-on-primary-container', 'shadow-md');
        box.classList.remove('bg-surface-container', 'text-primary');
        const disc = card.querySelector('.radio-disc');
        disc.classList.add('bg-primary-container', 'shadow-sm');
        disc.classList.remove('bg-surface-variant');
        disc.querySelector('span').classList.remove('opacity-0');
      });
    });

