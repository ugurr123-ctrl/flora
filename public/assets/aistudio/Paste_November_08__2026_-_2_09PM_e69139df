    const cyclePlus = document.getElementById('cyclePlus');
    const flowMinus = document.getElementById('flowMinus');
    const flowPlus = document.getElementById('flowPlus');
    const flowDurationDisplay = document.getElementById('flowDurationDisplay');
    const flowStatusBadge = document.getElementById('flowStatusBadge');
    const flowStatusDot = document.getElementById('flowStatusDot');
    const cycleProgressCircle = document.getElementById('cycleProgressCircle');
    const ringOvulationDay = document.getElementById('ringOvulationDay');
    const cycleStatusTip = document.getElementById('cycleStatusTip');
    const wheelPicker = document.getElementById('wheelPicker');
    const flowWheelPicker = document.getElementById('flowWheelPicker');

    // Transition & Home screen references
