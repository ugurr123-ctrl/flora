    /* Meditative Breathing */
    @keyframes ringBreathe {
      0% { transform: scale(1); box-shadow: 0 12px 28px rgba(216, 27, 96, 0.13); }
      50% { transform: scale(1.03); box-shadow: 0 18px 38px rgba(216, 27, 96, 0.24); }
      100% { transform: scale(1); box-shadow: 0 12px 28px rgba(216, 27, 96, 0.13); }
    }
    .animate-ring-breathe {
      animation: ringBreathe 4.5s cubic-bezier(0.45, 0.05, 0.55, 0.95) infinite;
    }

    /* Tactile Spring Pop */
    @keyframes springBounce {
      0% { transform: scale(1); }
      35% { transform: scale(0.86); }
      65% { transform: scale(1.12); }
      85% { transform: scale(0.96); }
      100% { transform: scale(1); }
    }
