    } else {
      btn.classList.remove('bg-gradient-to-r', 'from-primary', 'to-pink-500', 'justify-end');
      btn.classList.add(isVault ? 'bg-white/20' : 'bg-surface-container-high', 'justify-start');
      playCrystalChime(0.75);
    }
  }

  // Update Liquid Slider dynamically
  function updateWaterSlider(slider, event) {
    const val = parseFloat(slider.value).toFixed(1);
    const min = parseFloat(slider.min);
    const max = parseFloat(slider.max);
    const percentage = ((val - min) / (max - min)) * 100;
    
    const bar = document.getElementById('fluidBar');
    const label = document.getElementById('waterValueLabel');
    
    if (bar) {
      bar.style.width = percentage + '%';
    }
    if (label) {
      const glasses = Math.round(val / 0.3);
      label.innerText = `${val} Litre (${glasses} Bardak)`;
    }

    if (Math.random() > 0.6) {
      triggerPollen(event, 'sparkle');
    }
  }
</script>
