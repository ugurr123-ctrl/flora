<script id="pollen-sparkle-burst-engine">function createPollenBurst(x, y) { const colors = ['#fde047', '#ffd9de', '#a7f3d0', '#fbcfe8', '#fed7aa', '#d81b60', '#86efac']; const symbols = ['✦', '•', '✧', '🌸', '✨', '🍃', '•']; const particleCount = 10 + Math.floor(Math.random() * 4); for (let i = 0; i < particleCount; i++) { const p = document.createElement('span'); p.className = 'pollen-burst-particle'; const angle = (i / particleCount) * Math.PI * 2 + (Math.random() * 0.4 - 0.2); const distance = 28 + Math.random() * 45; const pdx = `${Math.cos(angle) * distance}px`; const pdy = `${Math.sin(angle) * distance - 8}px`; const prot = `${(Math.random() * 360 - 180)}deg`; const color = colors[Math.floor(Math.random() * colors.length)]; const isChar = Math.random() > 0.45; p.style.left = `${x}px`; p.style.top = `${y}px`; p.style.setProperty('--pdx', pdx); p.style.setProperty('--pdy', pdy); p.style.setProperty('--prot', prot); if (isChar) { p.textContent = symbols[Math.floor(Math.random() * symbols.length)]; p.style.fontSize = `${9 + Math.random() * 7}px`; p.style.color = color; } else { const size = 4 + Math.random() * 5; p.style.width = `${size}px`; p.style.height = `${size}px`; p.style.backgroundColor = color; p.style.boxShadow = `0 0 6px ${color}`; } document.body.appendChild(p); setTimeout(() => p.remove(), 750); } if (typeof triggerHaptic === 'function') triggerHaptic([12, 18]); if (typeof playDropletSound === 'function') playDropletSound(); } document.addEventListener('click', (e) => { const target = e.target.closest('.botanical-glow-petal, .botanical-sparkle, .petal-drift, #cycle-ring, .day-chip, #fav-btn'); if (target) { const rect = target.getBoundingClientRect(); const x = e.clientX || (rect.left + rect.width / 2); const y = e.clientY || (rect.top + rect.height / 2); createPollenBurst(x, y); } });</script>

