      osc1.frequency.exponentialRampToValueAtTime(1760 * pitchModifier, now + 0.08);
      osc1.frequency.exponentialRampToValueAtTime(1320 * pitchModifier, now + 0.35);

      gain1.gain.setValueAtTime(0.001, now);
      gain1.gain.linearRampToValueAtTime(0.2, now + 0.02);
      gain1.gain.exponentialRampToValueAtTime(0.0001, now + 0.4);

      // Delicate high shimmer overtone
      const osc2 = audioCtx.createOscillator();
      const gain2 = audioCtx.createGain();
      osc2.type = 'triangle';
      osc2.frequency.setValueAtTime(2640 * pitchModifier, now);
      gain2.gain.setValueAtTime(0.08, now);
      gain2.gain.exponentialRampToValueAtTime(0.0001, now + 0.25);

      osc1.connect(gain1);
      gain1.connect(audioCtx.destination);
      osc2.connect(gain2);
      gain2.connect(audioCtx.destination);

      osc1.start(now);
      osc2.start(now);
      osc1.stop(now + 0.45);
      osc2.stop(now + 0.3);
    } catch(e) {
      // Audio playback fails silently if user policy requires interaction
    }
  }

  // Pollen & Botanical Petal Particle Explosion
  function triggerPollen(e, theme = 'blossom') {
    playCrystalChime(theme === 'gold' ? 1.2 : (theme === 'rose' ? 0.9 : 1.05));
    
    const clickX = e.clientX || (e.touches && e.touches[0] ? e.touches[0].clientX : window.innerWidth / 2);
    const clickY = e.clientY || (e.touches && e.touches[0] ? e.touches[0].clientY : window.innerHeight / 2);

    const petals = ['🌸', '🌺', '✨', '🍃', '🌼', '💖', '💧', '🌿', '⭐'];
    const colors = ['#f43f5e', '#ec4899', '#10b981', '#f59e0b', '#06b6d4', '#d81b60', '#ffd700'];

    const count = 14;
    for (let i = 0; i < count; i++) {
      const p = document.createElement('div');
      p.className = 'pollen-particle select-none';
      
      const angle = (Math.PI * 2 / count) * i + (Math.random() - 0.5);
      const distance = 40 + Math.random() * 85;
      const tx = Math.cos(angle) * distance;
      const ty = Math.sin(angle) * distance;
      const rot = (Math.random() * 360) + 'deg';

      p.style.setProperty('--tw-tx', `${tx}px`);
      p.style.setProperty('--tw-ty', `${ty}px`);
      p.style.setProperty('--tw-rot', rot);

      p.style.left = `${clickX}px`;
      p.style.top = `${clickY}px`;

      if (i % 2 === 0) {
        // Emoji petal or sparkle
        p.innerText = petals[Math.floor(Math.random() * petals.length)];
        p.style.fontSize = `${12 + Math.random() * 10}px`;
      } else {
        // Glowing pollen sphere
        p.style.width = `${6 + Math.random() * 8}px`;
        p.style.height = p.style.width;
        p.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
        p.style.boxShadow = `0 0 10px ${p.style.backgroundColor}`;
      }

      document.body.appendChild(p);

      setTimeout(() => {
        if (p && p.parentNode) {
          p.parentNode.removeChild(p);
        }
      }, 950);
    }
  }

  // Toggle button handler with flower pollen effect
  function toggleSwitchWithPollen(btn, event) {
    event.stopPropagation();
    const isChecked = btn.getAttribute('data-checked') === 'true';
    const newState = !isChecked;
    btn.setAttribute('data-checked', newState ? 'true' : 'false');
    
    const isVault = btn.closest('.from-inverse-surface');
    
    if (newState) {
      btn.classList.remove('bg-surface-container-high', 'bg-white/20', 'justify-start');
      btn.classList.add('bg-gradient-to-r', 'from-primary', 'to-pink-500', 'justify-end');
