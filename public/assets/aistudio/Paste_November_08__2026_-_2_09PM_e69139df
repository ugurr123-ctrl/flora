    // Build Interactive 3D Cylindrical Wheel Picker (Numbers 21 to 42 for Cycle)
    const minDay = 21;
    const maxDay = 42;
    const wheelItems = [];

    const buildWheelPicker = () => {
      wheelPicker.innerHTML = '';
      for (let day = minDay; day <= maxDay; day++) {
        const item = document.createElement('div');
        item.className = 'wheel-item flex items-center justify-center w-full py-2.5 transition-all duration-150 cursor-pointer text-center font-bold tracking-tight';
        item.dataset.day = day;
        item.innerHTML = `<span class="wheel-num transition-all duration-200 text-2xl text-secondary/50 font-semibold">${day}</span>`;
        
        item.addEventListener('click', () => {
