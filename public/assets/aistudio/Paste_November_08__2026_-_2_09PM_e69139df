<script>
  // Web Audio API for delicate crystal water droplet sound
  let audioCtx = null;
  function playCrystalChime() {
    try {
      const AudioContext = window.AudioContext || window.webkitAudioContext;
      if (!audioCtx) audioCtx = new AudioContext();
      if (audioCtx.state === 'suspended') audioCtx.resume();
      
      const now = audioCtx.currentTime;
      const osc = audioCtx.createOscillator();
      const gain = audioCtx.createGain();
      
      // Sweet harmonic bell / water droplet pitch
      const baseFreq = 784 + Math.random() * 220; // G5 - A5 range
      osc.type = 'sine';
      osc.frequency.setValueAtTime(baseFreq, now);
      osc.frequency.exponentialRampToValueAtTime(baseFreq * 1.5, now + 0.08);

      gain.gain.setValueAtTime(0.22, now);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.35);

      osc.connect(gain);
      gain.connect(audioCtx.destination);

      osc.start(now);
      osc.stop(now + 0.35);
    } catch(e) {
      // Audio fallback silent
    }
  }

  // Canvas Particle Burst Simulation for Pollen & Botanical Sparkles
  const canvas = document.getElementById('pollen-canvas');
  const ctx = canvas.getContext('2d');
  let particles = [];

  function resizeCanvas() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }
  window.addEventListener('resize', resizeCanvas);
  resizeCanvas();

  const particleColors = [
    '#fbbf24', // Gold
    '#d81b60', // Fuchsia / Rose
    '#10b981', // Emerald
    '#a855f7', // Lavender
    '#f43f5e', // Coral Rose
    '#ffffff'  // Crystal White
  ];

  class PollenParticle {
    constructor(x, y) {
      this.x = x;
      this.y = y;
      const angle = Math.random() * Math.PI * 2;
      const speed = Math.random() * 4.5 + 2;
      this.vx = Math.cos(angle) * speed;
      this.vy = Math.sin(angle) * speed - 1.5;
      this.gravity = 0.12;
      this.size = Math.random() * 4.5 + 2.5;
      this.color = particleColors[Math.floor(Math.random() * particleColors.length)];
      this.alpha = 1;
      this.decay = Math.random() * 0.025 + 0.015;
      this.rotation = Math.random() * Math.PI * 2;
      this.rotSpeed = (Math.random() - 0.5) * 0.18;
      this.type = Math.random() > 0.4 ? 'petal' : 'sparkle';
    }

    update() {
      this.x += this.vx;
      this.y += this.vy;
      this.vy += this.gravity;
      this.vx *= 0.96;
      this.rotation += this.rotSpeed;
      this.alpha -= this.decay;
    }

    draw(ctx) {
      if (this.alpha <= 0) return;
      ctx.save();
      ctx.globalAlpha = Math.max(0, this.alpha);
      ctx.translate(this.x, this.y);
      ctx.rotate(this.rotation);
      ctx.fillStyle = this.color;
      ctx.shadowColor = this.color;
      ctx.shadowBlur = 6;

      if (this.type === 'petal') {
        // Draw soft botanical petal
        ctx.beginPath();
        ctx.ellipse(0, 0, this.size * 1.5, this.size * 0.75, 0, 0, Math.PI * 2);
        ctx.fill();
      } else {
        // Draw 4-point sparkle star
        ctx.beginPath();
        const s = this.size * 1.2;
        ctx.moveTo(0, -s);
        ctx.quadraticCurveTo(0, 0, s, 0);
        ctx.quadraticCurveTo(0, 0, 0, s);
        ctx.quadraticCurveTo(0, 0, -s, 0);
        ctx.quadraticCurveTo(0, 0, 0, -s);
        ctx.fill();
      }
      ctx.restore();
    }
  }

  function spawnBurst(x, y, count = 22) {
    for (let i = 0; i < count; i++) {
      particles.push(new PollenParticle(x, y));
    }
    playCrystalChime();
  }

  function animateParticles() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    for (let i = particles.length - 1; i >= 0; i--) {
      particles[i].update();
      particles[i].draw(ctx);
      if (particles[i].alpha <= 0) {
        particles.splice(i, 1);
      }
    }
    requestAnimationFrame(animateParticles);
  }
  animateParticles();

  // Micro-interaction for calendar days & tactile items
