        });

        wheelPicker.appendChild(item);
        wheelItems.push({ el: item, day: day });
      }
      highlightWheelItem(cycleLength, false);
    };

    const highlightWheelItem = (selectedDay, smoothScroll = true) => {
      wheelItems.forEach(item => {
        const numSpan = item.el.querySelector('.wheel-num');
        const diff = Math.abs(item.day - selectedDay);
        
        if (item.day === selectedDay) {
          item.el.classList.add('active-wheel-day');
          numSpan.className = 'wheel-num transition-all duration-200 text-4xl text-primary font-black scale-110 drop-shadow-sm';
          if (smoothScroll) {
            item.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            item.el.scrollIntoView({ behavior: 'auto', block: 'center' });
          }
        } else if (diff === 1) {
          numSpan.className = 'wheel-num transition-all duration-200 text-2xl text-on-surface/80 font-bold opacity-75';
        } else if (diff === 2) {
          numSpan.className = 'wheel-num transition-all duration-200 text-xl text-secondary/60 font-semibold opacity-50';
        } else {
          numSpan.className = 'wheel-num transition-all duration-200 text-lg text-secondary/30 font-medium opacity-25';
        }
      });
    };

    // Cycle Wheel Scroll listener with debounced snap calculation
    let isScrollingTimeout;
    wheelPicker.addEventListener('scroll', () => {
      clearTimeout(isScrollingTimeout);
      isScrollingTimeout = setTimeout(() => {
        const pickerRect = wheelPicker.getBoundingClientRect();
        const pickerCenter = pickerRect.top + pickerRect.height / 2;

        let closestDay = cycleLength;
        let smallestDistance = Infinity;

        wheelItems.forEach(item => {
          const itemRect = item.el.getBoundingClientRect();
          const itemCenter = itemRect.top + itemRect.height / 2;
          const dist = Math.abs(pickerCenter - itemCenter);
          if (dist < smallestDistance) {
            smallestDistance = dist;
            closestDay = item.day;
          }
        });

        if (closestDay !== cycleLength) {
          playHapticDrop(480);
          updateCycle(closestDay, false);
        }
      }, 70);
    });

    // Update cycle calculations
    const updateCycle = (val, scrollWheel = true) => {
      cycleLength = Math.max(minDay, Math.min(maxDay, val));
      previewDayCount.textContent = cycleLength;

      const half = Math.round(cycleLength / 2);
      ringOvulationDay.textContent = `Tahmini Ovülasyon: ${half}. Gün`;

      // Status description
      if (cycleLength >= 26 && cycleLength <= 32) {
        cycleStatusTip.textContent = `Sağlıklı & Düzenli (${cycleLength} gün)`;
        cycleStatusTip.previousElementSibling.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
      } else if (cycleLength < 26) {
        cycleStatusTip.textContent = `Kısa Döngü (${cycleLength} gün)`;
        cycleStatusTip.previousElementSibling.className = 'w-2 h-2 rounded-full bg-amber-500';
      } else {
        cycleStatusTip.textContent = `Uzun Döngü (${cycleLength} gün)`;
        cycleStatusTip.previousElementSibling.className = 'w-2 h-2 rounded-full bg-rose-400';
      }

      // Ring progress offset: 251.2 circumference for r=40
      const percent = (cycleLength - 20) / (45 - 20);
      const offset = 251.2 - (percent * 150);
      cycleProgressCircle.style.strokeDashoffset = offset;

      highlightWheelItem(cycleLength, scrollWheel);
    };

    buildWheelPicker();

    cycleMinus.addEventListener('click', () => {
      playHapticDrop(420);
      updateCycle(cycleLength - 1, true);
    });
    cyclePlus.addEventListener('click', () => {
      playHapticDrop(460);
      updateCycle(cycleLength + 1, true);
    });

    // BUILD FLOW DURATION 3D WHEEL PICKER (Days 2 to 10)
    const minFlowDay = 2;
    const maxFlowDay = 10;
    const flowWheelItems = [];

    const buildFlowWheelPicker = () => {
      flowWheelPicker.innerHTML = '';
      for (let day = minFlowDay; day <= maxFlowDay; day++) {
        const item = document.createElement('div');
        item.className = 'flow-wheel-item flex items-center justify-center w-full py-2.5 transition-all duration-150 cursor-pointer text-center font-bold tracking-tight';
        item.dataset.day = day;
        item.innerHTML = `<span class="flow-wheel-num transition-all duration-200 text-2xl text-secondary/50 font-semibold">${day}</span>`;
        
        item.addEventListener('click', () => {
          playHapticDrop(470);
          updateFlow(day, true);
        });

        flowWheelPicker.appendChild(item);
        flowWheelItems.push({ el: item, day: day });
      }
      highlightFlowWheelItem(flowDuration, false);
    };

    const highlightFlowWheelItem = (selectedDay, smoothScroll = true) => {
      flowWheelItems.forEach(item => {
        const numSpan = item.el.querySelector('.flow-wheel-num');
        const diff = Math.abs(item.day - selectedDay);
        
        if (item.day === selectedDay) {
          item.el.classList.add('active-flow-day');
          numSpan.className = 'flow-wheel-num transition-all duration-200 text-4xl text-primary font-black scale-110 drop-shadow-sm';
          if (smoothScroll) {
            item.el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            item.el.scrollIntoView({ behavior: 'auto', block: 'center' });
          }
        } else if (diff === 1) {
          numSpan.className = 'flow-wheel-num transition-all duration-200 text-2xl text-on-surface/80 font-bold opacity-75';
        } else if (diff === 2) {
          numSpan.className = 'flow-wheel-num transition-all duration-200 text-xl text-secondary/60 font-semibold opacity-50';
        } else {
          numSpan.className = 'flow-wheel-num transition-all duration-200 text-lg text-secondary/30 font-medium opacity-25';
        }
      });
    };

    let isFlowScrollingTimeout;
    flowWheelPicker.addEventListener('scroll', () => {
      clearTimeout(isFlowScrollingTimeout);
      isFlowScrollingTimeout = setTimeout(() => {
        const pickerRect = flowWheelPicker.getBoundingClientRect();
        const pickerCenter = pickerRect.top + pickerRect.height / 2;

        let closestDay = flowDuration;
        let smallestDistance = Infinity;

        flowWheelItems.forEach(item => {
          const itemRect = item.el.getBoundingClientRect();
          const itemCenter = itemRect.top + itemRect.height / 2;
          const dist = Math.abs(pickerCenter - itemCenter);
          if (dist < smallestDistance) {
            smallestDistance = dist;
            closestDay = item.day;
          }
        });

        if (closestDay !== flowDuration) {
          playHapticDrop(450);
          updateFlow(closestDay, false);
        }
      }, 70);
    });

    const updateFlow = (val, scrollWheel = true) => {
      flowDuration = Math.max(minFlowDay, Math.min(maxFlowDay, val));
      flowDurationDisplay.textContent = flowDuration;

      // Status badge and intensity synchronization
      if (flowDuration >= 4 && flowDuration <= 6) {
        flowStatusBadge.textContent = `${flowDuration} Gün • İdeal Süre`;
        flowStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-500 animate-pulse';
      } else if (flowDuration <= 3) {
        flowStatusBadge.textContent = `${flowDuration} Gün • Kısa Kanama`;
        flowStatusDot.className = 'w-2 h-2 rounded-full bg-amber-500';
      } else {
        flowStatusBadge.textContent = `${flowDuration} Gün • Uzun Kanama`;
        flowStatusDot.className = 'w-2 h-2 rounded-full bg-rose-400';
      }

      highlightFlowWheelItem(flowDuration, scrollWheel);
    };

    buildFlowWheelPicker();

    // Flow Duration Stepper
    flowMinus.addEventListener('click', () => {
      playHapticDrop(400);
      if (flowDuration > minFlowDay) {
        updateFlow(flowDuration - 1, true);
      }
    });
    flowPlus.addEventListener('click', () => {
      playHapticDrop(440);
      if (flowDuration < maxFlowDay) {
        updateFlow(flowDuration + 1, true);
      }
    });

    // Contraception method cards single selection
    const contraCards = document.querySelectorAll('.contra-card');
    contraCards.forEach(card => {
      card.addEventListener('click', () => {
        playHapticDrop(540);
        contraCards.forEach(c => {
          c.classList.remove('active-contra', 'bg-surface-container-low', 'border-primary-container');
          c.classList.add('bg-white', 'border-surface-variant/80');
          const check = c.querySelector('.contra-check');
          check.classList.remove('bg-primary-container', 'text-white');
          check.classList.add('bg-surface-variant', 'text-transparent');
        });

        card.classList.add('active-contra', 'bg-surface-container-low', 'border-primary-container');
        card.classList.remove('bg-white', 'border-surface-variant/80');
        const check = card.querySelector('.contra-check');
        check.classList.remove('bg-surface-variant', 'text-transparent');
        check.classList.add('bg-primary-container', 'text-white');
        selectedContraception = card.dataset.contra;
      });
    });

    // Step Rendering
    const renderStep = (step) => {
      playHapticDrop(460);
      currentStep = step;
      currentStepText.textContent = step;

      if (step === 1) {
        step1.classList.remove('hidden');
        step2.classList.add('hidden');
        step3.classList.add('hidden');
        backBtn.classList.add('hidden');
        nextBtnText.textContent = 'Devam Et';
        nextBtnIcon.textContent = 'arrow_forward';

        seg1.className = 'h-2 flex-1 rounded-full bg-primary-container shadow-sm transition-all duration-500 ease-out flex items-center justify-end pr-0.5';
        seg2.className = 'h-2 flex-1 rounded-full bg-surface-variant transition-all duration-500 ease-out';
        seg3.className = 'h-2 flex-1 rounded-full bg-surface-variant transition-all duration-500 ease-out';
      } else if (step === 2) {
        step1.classList.add('hidden');
        step2.classList.remove('hidden');
        step3.classList.add('hidden');
        backBtn.classList.remove('hidden');
        nextBtnText.textContent = 'Devam Et';
        nextBtnIcon.textContent = 'arrow_forward';

        seg1.className = 'h-2 flex-1 rounded-full bg-primary-container transition-all duration-500 ease-out';
        seg2.className = 'h-2 flex-1 rounded-full bg-primary-container shadow-sm transition-all duration-500 ease-out flex items-center justify-end pr-0.5';
        seg3.className = 'h-2 flex-1 rounded-full bg-surface-variant transition-all duration-500 ease-out';
        setTimeout(() => {
          highlightWheelItem(cycleLength, true);
          highlightFlowWheelItem(flowDuration, true);
        }, 80);
      } else if (step === 3) {
        step1.classList.add('hidden');
        step2.classList.add('hidden');
        step3.classList.remove('hidden');
        backBtn.classList.remove('hidden');
        nextBtnText.textContent = '✨ Flora Alanımı Başlat';
        nextBtnIcon.textContent = 'check';

        seg1.className = 'h-2 flex-1 rounded-full bg-primary-container transition-all duration-500 ease-out';
        seg2.className = 'h-2 flex-1 rounded-full bg-primary-container transition-all duration-500 ease-out';
        seg3.className = 'h-2 flex-1 rounded-full bg-primary-container shadow-sm transition-all duration-500 ease-out flex items-center justify-end pr-0.5';
      }
      window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    // Goal Cards Selection
    const goalCards = document.querySelectorAll('.goal-card');
    goalCards.forEach(card => {
      card.addEventListener('click', () => {
        playHapticDrop(500);
        goalCards.forEach(c => {
          c.classList.remove('active-goal', 'bg-surface-container-low', 'shadow-md', 'border-primary-fixed');
          c.classList.add('bg-surface-container-lowest', 'shadow-sm', 'border-transparent');
          const box = c.querySelector('.goal-icon-box');
          box.classList.remove('bg-primary-container', 'text-on-primary-container', 'shadow-md');
          box.classList.add('bg-surface-container', 'text-primary');
          const disc = c.querySelector('.radio-disc');
          disc.classList.remove('bg-primary-container', 'shadow-sm');
          disc.classList.add('bg-surface-variant');
          disc.querySelector('span').classList.add('opacity-0');
