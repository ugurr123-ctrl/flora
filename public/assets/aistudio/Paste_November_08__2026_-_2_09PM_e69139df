<script>
  (function() {
    // Pollen & Ambient Petal Dust Micro Particle Generator
    const canvas = document.getElementById('flora-particles-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    
    let width = canvas.width = canvas.offsetWidth;
    let height = canvas.height = canvas.offsetHeight;

    window.addEventListener('resize', () => {
      if (!canvas) return;
      width = canvas.width = canvas.offsetWidth;
      height = canvas.height = canvas.offsetHeight;
    });

    const particles = [];
    const particleCount = 24;
    const colors = [
      'rgba(216, 27, 96, 0.35)',
      'rgba(242, 182, 203, 0.45)',
      'rgba(255, 216, 229, 0.55)',
      'rgba(255, 178, 191, 0.4)',
      'rgba(254, 193, 214, 0.35)'
    ];

    for (let i = 0; i < particleCount; i++) {
      particles.push({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: Math.random() * 2.8 + 1,
        color: colors[Math.floor(Math.random() * colors.length)],
        vx: (Math.random() - 0.5) * 0.4,
        vy: -Math.random() * 0.5 - 0.15,
        alpha: Math.random() * 0.8 + 0.2,
        phase: Math.random() * Math.PI * 2
      });
    }

    let animationFrameId;
    function render() {
      ctx.clearRect(0, 0, width, height);

      particles.forEach(p => {
        p.x += p.vx + Math.sin(p.phase) * 0.25;
        p.y += p.vy;
        p.phase += 0.02;

        if (p.y < -10) {
          p.y = height + 10;
          p.x = Math.random() * width;
        }
        if (p.x < -10) p.x = width + 10;
        if (p.x > width + 10) p.x = -10;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = p.color;
        ctx.fill();
      });

      animationFrameId = requestAnimationFrame(render);
    }
    render();

    // Tactile Button Click Bloom Interaction
    const startBtn = document.getElementById('btn-start-journey');
    if (startBtn) {
      startBtn.addEventListener('click', function(e) {
        // Create delightful tactile micro ripple
        const rect = startBtn.getBoundingClientRect();
        const ripple = document.createElement('span');
        const diameter = Math.max(rect.width, rect.height);
        const radius = diameter / 2;

        ripple.style.width = ripple.style.height = `${diameter}px`;
        ripple.style.left = `${e.clientX - rect.left - radius}px`;
        ripple.style.top = `${e.clientY - rect.top - radius}px`;
        ripple.className = 'absolute rounded-full bg-white/40 pointer-events-none transform scale-0 animate-ping';
        ripple.style.animationDuration = '0.6s';

        startBtn.appendChild(ripple);
        setTimeout(() => ripple.remove(), 650);
      });
    }
  })();
</script></main></body></html>

